<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab_3_OOP.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20">

            <Button
        Text="Add Book"
        Clicked="OnAddBookClicked"/>

            <CollectionView
        x:Name="BooksCollection">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame Margin="5">

                            <VerticalStackLayout>

                                <Label
                            Text="{Binding Title}"
                            FontSize="20"/>

                                <Label
                            Text="{Binding Author}"/>

                                <Button
                            Text="Delete"
                            Clicked="OnDeleteClicked"/>

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

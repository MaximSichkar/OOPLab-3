<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab_3_OOP_MAUI.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20">

            <Button Text="Add Book" Clicked="OnAddBookClicked"/>

            <CollectionView x:Name="BooksCollection">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Margin="10">

                            <VerticalStackLayout>

                                <Label Text="{Binding Title}" FontSize="20"/>
                                <Label Text="{Binding Author, StringFormat='Author: {0}'}" />
                                <Label Text="{Binding Genre, StringFormat='Genre: {0}'}" />
                                <Label Text="{Binding Year, StringFormat='Year: {0}'}" />
                                <Label Text="{Binding Price, StringFormat='Price: {0}$'}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                                    <Button Grid.Column="0" Text="Edit" Clicked="OnEditClicked"/>

                                    <Button Grid.Column="1" Text="Delete" Clicked="OnDeleteClicked"/>

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
